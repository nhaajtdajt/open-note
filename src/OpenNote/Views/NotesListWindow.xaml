<Window x:Class="OpenNote.Views.NotesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:OpenNote.Views"
        x:ClassModifier="internal"
        Title="Open Note"
        Width="440" Height="560" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Symbol" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Line" Color="#E2E2E2" />

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter Margin="0,0,0,6" />
                            <Border x:Name="Bar" Height="2" CornerRadius="1" Background="Transparent" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#1F1F1F" />
                                <Setter TargetName="Bar" Property="Background" Value="#D9A400" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Flat rows on a hairline, not cards: the little paper swatch carries the color. -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9E9E9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B88A00" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,14,16,10">
        <!-- Search + new -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock x:Name="SearchHint" Text="{v:T 'Search notes  (Ctrl+F)'}" Foreground="#9A9A9A"
                               VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="28,7,8,7"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                </Grid>
            </Border>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Click="NewNote_Click" Cursor="Hand"
                    ToolTip="{v:T 'New note'}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFE680" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{v:T 'New note'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBDB5C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Tabs -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,10">
            <RadioButton x:Name="NotesTab" Style="{StaticResource Tab}" IsChecked="True" Checked="Tab_Checked" />
            <RadioButton x:Name="ArchiveTab" Style="{StaticResource Tab}" Checked="Tab_Checked" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#9A9A9A" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"
                   x:Name="FooterHint" />

        <Grid>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,40,0,0" TextAlignment="Center" TextWrapping="Wrap" />
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource Row}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,6,0" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- A tiny sticky note: paper plus its adhesive strip. -->
                            <Grid Width="22" Height="22" Margin="10,11,0,0" VerticalAlignment="Top">
                                <Border CornerRadius="3" Background="{Binding Swatch}" BorderBrush="#1A000000" BorderThickness="1" />
                                <Border CornerRadius="3,3,0,0" Height="6" VerticalAlignment="Top" Margin="1,1,1,0" Background="{Binding StripSwatch}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,9,8,10">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#1F1F1F" />
                                <TextBlock Text="{Binding Preview}" Foreground="#5E5E5E" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" Visibility="{Binding PreviewVisibility}" />
                                <TextBlock Text="{Binding Meta}" Foreground="#9A9A9A" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RowButton}" Content="&#xE7B8;" ToolTip="{v:T 'Archive'}"
                                        Click="Archive_Click" Visibility="{Binding ActiveVisibility}" />
                                <Button Style="{StaticResource RowButton}" Content="&#xE7A7;" ToolTip="{v:T 'Restore to desktop'}"
                                        Click="Restore_Click" Visibility="{Binding ArchivedVisibility}" />
                                <Button Style="{StaticResource RowButton}" Content="&#xE74D;" ToolTip="{v:T 'Delete permanently'}"
                                        Click="Delete_Click" Visibility="{Binding ArchivedVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
