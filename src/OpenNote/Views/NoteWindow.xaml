<Window x:Class="OpenNote.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="OpenNote note"
        Width="284" Height="264" MinWidth="184" MinHeight="128"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <!-- Native resize edges for this borderless, per-pixel-transparent window. The window is
         12px larger than the glass on each side (room for the shadow), so the grab zone
         covers the shadow plus a few pixels of the glass edge, like Windows 11 windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="16" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Margin="12">
        <!-- 1. Tinted glass body. It casts the shadow; text lives on a separate layer above,
                so it never goes through the effect pipeline. -->
        <Border x:Name="Glass" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect x:Name="Shadow" Color="Black" Direction="270"
                                  BlurRadius="12" ShadowDepth="3" Opacity="0.16" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- 2. Specular sheen: light catching the upper part of the glass. -->
        <Border x:Name="Sheen" CornerRadius="14" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop x:Name="SheenTop" Color="#66FFFFFF" Offset="0" />
                    <GradientStop Color="#1AFFFFFF" Offset="0.28" />
                    <GradientStop Color="#00FFFFFF" Offset="0.6" />
                    <GradientStop Color="#12FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 3. Content. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: drag to move, click to rename, right-click for options. -->
            <Border x:Name="Header" CornerRadius="14,14,0,0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseRightButtonUp="Header_MouseRightButtonUp">
                <Grid Margin="5,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <!-- room for the star badge that overlaps the corner -->
                        <Border Width="19" />
                        <TextBlock x:Name="LockGlyph" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Margin="2,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"
                                   ToolTip="Locked. Ctrl+L to unlock." />
                    </StackPanel>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                               FontWeight="Bold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <TextBox x:Name="TitleEditor" Grid.Column="1" Margin="0,5" Padding="3,1" Visibility="Collapsed"
                             VerticalContentAlignment="Center" FontWeight="Bold" BorderThickness="0" MaxLength="120"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                             CaretBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                                  VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="PinButton_Click" />
                        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                                Click="MenuButton_Click" ToolTip="Note options" />
                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                Click="CloseButton_Click" ToolTip="Close note (Ctrl+W)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Placeholder sits behind the transparent editor and shows only while the note is empty. -->
            <TextBlock x:Name="Placeholder" Grid.Row="1" Text="love basics again" Margin="15,10,14,0"
                       IsHitTestVisible="False" Opacity="0.45" TextTrimming="CharacterEllipsis" />

            <!-- Rich text only for bold and italic; everything else is kept plain (see RichText). -->
            <!-- Pictures are inert content (not IsDocumentEnabled), so clicks reach the editor:
                 the caret moves around them and they can be selected and deleted like text. -->
            <RichTextBox x:Name="Editor" Grid.Row="1" xml:lang="en-US" UndoLimit="100"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0" Padding="11,9,6,6"
                         SpellCheck.IsEnabled="False" SelectionOpacity="0.35"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                         CaretBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}">
                <RichTextBox.Template>
                    <!-- Bare template: no focus/hover border, just the scrolling text. -->
                    <ControlTemplate TargetType="RichTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      Focusable="False" Background="Transparent" />
                    </ControlTemplate>
                </RichTextBox.Template>
                <RichTextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </RichTextBox.Resources>
                <RichTextBox.ContextMenu>
                    <!-- Rebuilt each time it opens (spelling suggestions depend on the word). -->
                    <ContextMenu />
                </RichTextBox.ContextMenu>
                <FlowDocument PagePadding="0" />
            </RichTextBox>

            <!-- When the note was created: small and quiet. -->
            <TextBlock x:Name="Footer" Grid.Row="2" Margin="15,0,14,7" Opacity="0.5" FontSize="10.5"
                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- 4. Edges: a dark hairline defines the glass on light backgrounds, and an inner rim
                of light (bright on top, fading down) gives it thickness. -->
        <Border x:Name="Edge" CornerRadius="14" BorderThickness="1" IsHitTestVisible="False" />
        <Border x:Name="Rim" CornerRadius="13" Margin="1" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="RimTop" Color="#CCFFFFFF" Offset="0" />
                    <GradientStop Color="#33FFFFFF" Offset="0.45" />
                    <GradientStop Color="#4DFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- 5. The star. Not marked: a plain upright outline star inside the corner, always visible. Marked: it
                lights up, tilts and flies to the corner as a solid navy star with a white halo that overlaps the
                note's edge, so you can see at a glance which notes matter. The button sits where the marked star ends up. -->
        <Button x:Name="StarButton" Width="38" Height="38" Margin="-12,-12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Focusable="False" Cursor="Arrow" Click="StarButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Presenter" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.14" ScaleY="1.14" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid Width="31" Height="31">
                <!-- a flash of light when the star is marked -->
                <Ellipse x:Name="StarFlash" Width="34" Height="34" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="FlashScale" ScaleX="0.5" ScaleY="0.5" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#CCFFF3A8" Offset="0" />
                            <GradientStop Color="#66FFD84A" Offset="0.5" />
                            <GradientStop Color="#00FFD84A" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid x:Name="StarVisual" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="StarScale" ScaleX="0.68" ScaleY="0.68" />
                            <RotateTransform x:Name="StarTurn" Angle="0" />
                            <TranslateTransform x:Name="StarMove" X="8" Y="10" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <!-- not marked: outline in the note's ink colour -->
                    <Path x:Name="StarOutline" Data="M 10,1.7 L 12.65,7.26 L 18.75,8.06 L 14.28,12.29 L 15.41,18.34 L 10,15.4 L 4.59,18.34 L 5.72,12.29 L 1.25,8.06 L 7.35,7.26 Z" Stretch="Uniform" Margin="3" Opacity="0.7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                          StrokeThickness="1.9" StrokeLineJoin="Round" Fill="Transparent" />
                    <!-- marked: white halo and a solid navy star -->
                    <Grid x:Name="StarOn" Opacity="0">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.35" RenderingBias="Performance" />
                        </Grid.Effect>
                        <Path Data="M 10,1.7 L 12.65,7.26 L 18.75,8.06 L 14.28,12.29 L 15.41,18.34 L 10,15.4 L 4.59,18.34 L 5.72,12.29 L 1.25,8.06 L 7.35,7.26 Z" Stretch="Uniform" Margin="1" Fill="White" Stroke="White" StrokeThickness="4.2" StrokeLineJoin="Round" />
                        <Path Data="M 10,1.7 L 12.65,7.26 L 18.75,8.06 L 14.28,12.29 L 15.41,18.34 L 10,15.4 L 4.59,18.34 L 5.72,12.29 L 1.25,8.06 L 7.35,7.26 Z" Stretch="Uniform" Margin="3" Fill="#FF1F2A5C" Stroke="#FF1F2A5C" StrokeThickness="1.8" StrokeLineJoin="Round" />
                    </Grid>
                </Grid>
            </Grid>
        </Button>    </Grid>
</Window>
