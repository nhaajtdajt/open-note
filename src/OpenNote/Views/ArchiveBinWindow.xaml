<Window x:Class="OpenNote.Views.ArchiveBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:OpenNote.Views"
        x:ClassModifier="internal"
        Title="Open Note archive" Width="176" Height="196"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- The archive bin that slides in from the right edge while a note is being dragged.
         Click-through and never activated: it must not get in the note's way. Everything
         lives in Stage, which starts pushed off the right edge of this window (= the screen). -->
    <Grid x:Name="Stage" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" X="200" />
        </Grid.RenderTransform>

        <!-- Warm glow behind the bin while a note is over it. -->
        <Ellipse x:Name="Glow" Width="150" Height="150" Opacity="0"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-1">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#99FFD64A" Offset="0" />
                    <GradientStop Color="#33FFD64A" Offset="0.55" />
                    <GradientStop Color="#00FFD64A" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Says what the bin does: it archives, it does not delete. -->
        <Border x:Name="Label" Opacity="0" CornerRadius="11" Padding="11,4,11,5"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,160"
                Background="#EB1F2733">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LabelShift" Y="6" />
            </Border.RenderTransform>
            <TextBlock Text="{v:T 'Archive'}" Foreground="White" FontSize="13"
                       FontFamily="Segoe UI Variable Text, Segoe UI" />
        </Border>

        <!-- The bin, 112 x 124: a dark basket with a blue grid, full of crumpled paper. -->
        <Grid x:Name="BinHost" Width="112" Height="124" Margin="0,0,14,12"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BinScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Canvas Width="112" Height="124">
                <!-- Contact shadow: a soft ellipse, not a blur effect (an effect is redrawn in software on every animation frame). -->
                <Ellipse Canvas.Left="12" Canvas.Top="108" Width="88" Height="16">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66000000" Offset="0" />
                            <GradientStop Color="#33000000" Offset="0.55" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Basket body, narrower at the bottom -->
                <Path Data="M 8,34 L 22,108 C 30,121 82,121 90,108 L 104,34 Z" StrokeThickness="1.2" Stroke="#FFEEF2FA" StrokeLineJoin="Round">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF48E2CF" Offset="0" />
                            <GradientStop Color="#FF1FBFB6" Offset="0.45" />
                            <GradientStop Color="#FF0F96A6" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <!-- Light on the left side -->
                <Path Data="M 12,40 L 20,40 L 31,108 C 29,107 27,106 26,104 Z" Fill="#33FFFFFF" />
                <!-- The blue grid (rings and ribs) -->
                <Path Stroke="#F2FFFFFF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 10.4,46.6 Q 56,78.5 101.6,46.6 M 12.9,59.9 Q 56,89.7 99.1,59.9 M 15.4,73.2 Q 56,100.9 96.6,73.2 M 17.8,85.8 Q 56,111.4 94.2,85.8 M 20,97.6 Q 56,121.3 92,97.6" />
                <Path Stroke="#F2FFFFFF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 14,35 L 26.2,107 M 28,52 L 36.2,118 M 42,52 L 46.1,118 M 56,52 L 56,118 M 70,52 L 65.9,118 M 84,52 L 75.8,118 M 98,35 L 85.8,107" />

                <!-- Inside of the opening, dark -->
                <Path Data="M 8,34 A 48,17 0 1 1 104,34 A 48,17 0 1 1 8,34 Z" Fill="#FF0A6677" Stroke="#FFFFFFFF" StrokeThickness="1.2" />
                <Path Data="M 14,34 A 42,14 0 1 1 98,34 A 42,14 0 1 1 14,34 Z" Fill="#FF0D7F91" />

                <!-- Crumpled paper heaped in the opening; it rises when a note is over the bin -->
                <Canvas x:Name="Paper">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="PaperLift" Y="0" />
                    </Canvas.RenderTransform>
                    <Polygon Points="22,36 26,27 34,25 38,31 36,39 28,41" Fill="#FFE6E9F0" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <Polygon Points="72,31 79,21 89,23 93,31 89,39 77,41" Fill="#FFD9DCE5" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <Polygon Points="24,40 36,35 46,41 44,47 30,47" Fill="#FFCFD3DD" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <Polygon Points="62,41 74,37 88,41 83,47 66,48" Fill="#FFC7CCD8" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <Polygon Points="34,29 40,17 50,12 59,18 57,28 47,34 38,35" Fill="#FFFFFFFF" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <Polygon Points="52,27 60,12 72,9 80,18 78,29 66,35" Fill="#FFF2F4F8" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <Polygon Points="44,35 54,29 66,33 70,41 58,47 46,43" Fill="#FFF8F9FC" Stroke="#FF8F97A6" StrokeThickness="0.8" StrokeLineJoin="Round" />
                    <!-- creases -->
                    <Path Stroke="#FF9AA2B2" StrokeThickness="0.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 40,18 L 46,25 L 44,33 M 62,13 L 67,22 L 62,31 M 74,22 L 80,29 L 78,36 M 29,29 L 33,35 M 52,37 L 58,41 M 70,39 L 76,43 M 50,15 L 53,22" />
                    <!-- warm tint when a note is over the bin -->
                    <Polygon x:Name="Warm" Opacity="0" Fill="#FFFFD64A"
                             Points="20,36 26,25 38,14 58,8 80,9 91,20 94,36 86,46 56,50 28,47" />
                </Canvas>

                <!-- Front lip of the basket, over the paper: a white rim (with a faint grey edge so it shows on light backgrounds too) -->
                <Path Data="M 8,34 A 48,17 0 0 0 104,34" Stroke="#4D1F2638" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 8,34 A 48,17 0 0 0 104,34" Stroke="#FFF7F9FD" StrokeThickness="7.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 12,37 A 44,15 0 0 0 100,37" Stroke="#33203050" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />                <!-- speckles on the rim -->
                <Path Fill="#FFC3C9D6" Data="M 30,50 h 1.6 v 1.6 h -1.6 Z M 44,53 h 1.6 v 1.6 h -1.6 Z M 62,53 h 1.6 v 1.6 h -1.6 Z M 78,50 h 1.6 v 1.6 h -1.6 Z M 52,54 h 1.4 v 1.4 h -1.4 Z" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
