<Window x:Class="OpenNote.Views.PickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Choose notes" Width="390" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Symbol" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Margin="0,1" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <Grid>
                                <ContentPresenter />
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE680" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A6A00" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow inside the transparent window. -->
    <Border Margin="12" CornerRadius="14" Background="#FCFCFA" BorderBrush="#24000000" BorderThickness="1" Padding="14,14,14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                <TextBlock Text="Keep these notes on screen" FontSize="15" FontWeight="SemiBold" Foreground="#1F1F1F" />
                <TextBlock x:Name="Hint" Margin="0,3,0,0" Foreground="#666666" TextWrapping="Wrap"
                           Text="Space or click selects a note. Enter keeps the selected ones and hides the rest. Esc cancels." />
            </StackPanel>
            <TextBlock x:Name="Warning" DockPanel.Dock="Bottom" Margin="2,8,0,0" Foreground="#9A3412"
                       Text="Select at least one note." Visibility="Collapsed" />
            <ListBox x:Name="List" SelectionMode="Multiple" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource Row}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,7,36,7">
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Border CornerRadius="5" Background="{Binding Swatch}" BorderBrush="#1A000000" BorderThickness="1" />
                                <Border CornerRadius="5,5,0,0" Height="6" VerticalAlignment="Top" Margin="1,1,1,0" Background="{Binding StripSwatch}" />
                            </Grid>
                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="250"
                                       TextTrimming="CharacterEllipsis" Foreground="#1F1F1F" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
