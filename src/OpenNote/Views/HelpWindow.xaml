<Window x:Class="OpenNote.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Open Note: how to use" Width="840" Height="670"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Colours come from the card's own pictures: the paper (most of it), warm brown ink for the
         text and the keys (from the kraft letter and the bag), the daisy leaves' olive for headings
         and buttons, and red only for the title and the heart, so it stays an accent. -->
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF4A5E32" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#FF3A3128" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A small ink-outlined pill: the page and language switches, the copy buttons. -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF4A5E32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="10" BorderThickness="1" BorderBrush="#994A5E32" Background="#14FFFFFF" Padding="10,2,10,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#FF4A5E32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A sheet of handmade paper with daisies printed in both bottom corners, a bag of flowers
         with a letter tucked under it hanging at the top left (they sway together; a click shows
         the letter),
         a painted heart at the top right. Click, Esc or the shortcut again closes it. -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Everything that never moves, drawn once and kept as one picture (the swinging bag
             would otherwise make every layer be redrawn on every frame). -->
        <Canvas x:Name="Scenery" CacheMode="BitmapCache">
            <Grid Canvas.Left="34" Canvas.Top="34" Width="772" Height="614">
                <!-- The flowers are printed on the paper: cut along its torn edge. -->
                <Grid.OpacityMask>
                    <ImageBrush ImageSource="/Assets/help/paper.png" />
                </Grid.OpacityMask>
                <Image Source="/Assets/help/paper.png" Stretch="Fill" />
                <Image Source="/Assets/help/daisies.png" Width="196" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                <Image Source="/Assets/help/bouquet.png" Width="166" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            </Grid>
            <Image Source="/Assets/help/heart.png" Width="72" Canvas.Left="756" Canvas.Top="6" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="12" />
                </Image.RenderTransform>
            </Image>
            <Image Source="/Assets/help/title.png" Width="270" Canvas.Left="196" Canvas.Top="56" />
        </Canvas>

        <TextBlock x:Name="Subtitle" Margin="202,104,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" FontStyle="Italic" Foreground="#B33A3128" />

        <!-- The AI agents page, and the display language (remembered in settings.json) -->
        <StackPanel Margin="0,68,96,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
            <Button x:Name="AiButton" Style="{StaticResource Pill}" Margin="0,0,6,0" Click="AiButton_Click" />
            <Button x:Name="LanguageButton" Style="{StaticResource Pill}" Click="LanguageButton_Click" />
        </StackPanel>

        <!-- Page 1: two columns of shortcuts -->
        <Grid x:Name="KeysPage" Margin="196,196,58,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="AnywhereHeading" Style="{StaticResource Heading}" />
                <StackPanel x:Name="Anywhere" Grid.IsSharedSizeScope="True" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="InNoteHeading" Style="{StaticResource Heading}" />
                <StackPanel x:Name="InNote" Grid.IsSharedSizeScope="True" />
            </StackPanel>
        </Grid>

        <!-- Page 2: AI agents. The note style typed here is what agents follow (opennote-ai). -->
        <StackPanel x:Name="AiPage" Margin="196,172,58,0" VerticalAlignment="Top" Visibility="Collapsed" Grid.IsSharedSizeScope="True">
            <TextBlock x:Name="AiIntro" Style="{StaticResource Body}" LineHeight="19" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PromptLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AskLabel" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Grid.Column="1" CornerRadius="6" Background="#1A4A5E32" Padding="8,3">
                    <TextBlock x:Name="AskPrompt" Style="{StaticResource Body}" FontStyle="Italic" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button x:Name="CopyAsk" Grid.Column="2" Style="{StaticResource Pill}" Margin="6,0,0,0" Click="CopyAsk_Click" />
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PromptLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LearnLabel" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Grid.Column="1" CornerRadius="6" Background="#1A4A5E32" Padding="8,3">
                    <TextBlock x:Name="LearnPrompt" Style="{StaticResource Body}" FontStyle="Italic" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button x:Name="CopyLearn" Grid.Column="2" Style="{StaticResource Pill}" Margin="6,0,0,0" Click="CopyLearn_Click" />
            </Grid>
            <TextBlock x:Name="StyleLabel" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,3" />
            <Grid>
                <TextBox x:Name="StyleBox" Height="128" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" Foreground="#FF3A3128"
                         Background="#33FFFFFF" BorderBrush="#664A5E32" Padding="4,3" MaxLength="4000" />
                <TextBlock x:Name="StylePlaceholder" Style="{StaticResource Body}" Margin="8,4,8,0" Foreground="#803A3128"
                           FontSize="12.5" LineHeight="16" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" MaxHeight="122" />
            </Grid>
            <CheckBox x:Name="AllowBox" Margin="0,6,0,0" Foreground="#FF3A3128" Cursor="Hand"
                      FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" />
        </StackPanel>

        <!-- One line of tips (shortcuts page), then how to close -->
        <TextBlock x:Name="Tips" Margin="196,432,72,0" VerticalAlignment="Top" TextWrapping="Wrap"
                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" Foreground="#FF3A3128" LineHeight="19" />
        <!-- A word from the author, in the empty space above the closing hint (filled in by Fill). -->
        <TextBlock x:Name="Feedback" Margin="196,0,216,92" HorizontalAlignment="Left" VerticalAlignment="Bottom" TextWrapping="Wrap"
                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" Foreground="#E63A3128" LineHeight="19" />
        <TextBlock x:Name="CloseHint" Margin="212,0,0,44" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontStyle="Italic" Foreground="#993A3128" />

        <!-- The bag of flowers, with a little letter hidden under it, hangs from its strap and
             sways as one piece; a click on either shows the letter. -->
        <Canvas x:Name="Hanger" Width="140" Height="190" Margin="44,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="Hand" RenderTransformOrigin="0.376,0" MouseLeftButtonUp="Bag_MouseLeftButtonUp">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="Swing" Angle="0" />
            </Canvas.RenderTransform>
            <!-- The little letter hidden under the bag, peeking out on its left: it grows under the mouse and gives
                 a small shake now and then, so it's clear it can be opened. -->
            <Image x:Name="Letter" Source="/Assets/help/envelope.png" Width="66" Canvas.Left="-32" Canvas.Top="96"
                   RenderTransformOrigin="0.5,0.3" MouseEnter="Letter_MouseEnter" MouseLeave="Letter_MouseLeave">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LetterHover" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="LetterTilt" Angle="-12" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Assets/help/bag.png" Width="140" />
        </Canvas>
        <!-- The letter: a thank-you note on an instant photo of flowers, a little tilted, lying on its
             own soft shadow (pictures from tools/make-letter-art.py). -->
        <Grid x:Name="MenuCard" Width="408" Height="515" Margin="204,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
              Visibility="Collapsed" RenderTransformOrigin="0,0" MouseLeftButtonUp="MenuCard_MouseLeftButtonUp">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MenuPop" ScaleX="1" ScaleY="1" />
                    <RotateTransform Angle="-2.5" CenterX="204" CenterY="258" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Image Source="/Assets/help/letter-shadow.png" Stretch="Fill" Margin="0,6,0,-6" />
            <Image Source="/Assets/help/letter-card.jpg" Margin="24" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
            <!-- On the signature's line, at the left: opens the song on YouTube in the browser
                 (a link only: no music is shipped with the app). -->
            <Button x:Name="ListenButton" Margin="44,452,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Cursor="Hand" Focusable="False" Click="ListenButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="11" BorderThickness="1" BorderBrush="#801D3E86" Background="#0F1D3E86" Padding="10,2,11,3">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="#FF1D3E86"
                                       FontFamily="Sitka Text, Georgia" FontSize="13.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#261D3E86" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF1D3E86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>

</Window>
