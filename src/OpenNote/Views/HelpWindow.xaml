<Window x:Class="OpenNote.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Open Note: how to use" Width="620" Height="453"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Ink Free, Segoe Print" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF7A2A22" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <!-- An old sheet of paper with a heart wax seal, the shortcuts written on it. Click, Esc or
         the shortcut again closes it. -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Image Source="/Assets/help-card.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Title, beside the seal -->
        <StackPanel Margin="146,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="Open Note" FontFamily="Ink Free, Segoe Print" FontSize="30" FontWeight="Bold" Foreground="#FF6E2620" />
            <TextBlock x:Name="Subtitle" Margin="2,0,0,0"
                       FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5" FontStyle="Italic" Foreground="#B33B2A1E" />
        </StackPanel>

        <!-- Switches the card between English and Vietnamese (remembered in settings.json) -->
        <Button x:Name="LanguageButton" Margin="0,88,52,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="Hand" Focusable="False" Click="LanguageButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="10" BorderThickness="1" BorderBrush="#997A2A22" Background="#14FFFFFF" Padding="10,2,10,3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#FF7A2A22" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="LanguageText" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#FF6E2620" />
        </Button>

        <!-- Two columns of shortcuts -->
        <Grid Margin="84,148,40,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="AnywhereHeading" Style="{StaticResource Heading}" />
                <StackPanel x:Name="Anywhere" Grid.IsSharedSizeScope="True" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="InNoteHeading" Style="{StaticResource Heading}" />
                <StackPanel x:Name="InNote" Grid.IsSharedSizeScope="True" />
            </StackPanel>
        </Grid>

        <!-- One line of tips, then how to close -->
        <StackPanel Margin="84,0,40,30" VerticalAlignment="Bottom">
            <TextBlock x:Name="Tips" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#FF3B2A1E" LineHeight="17" />
            <TextBlock x:Name="CloseHint" Margin="0,8,0,0" HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" FontStyle="Italic" Foreground="#993B2A1E" />
        </StackPanel>
    </Grid>

</Window>
